# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

if [ -f /etc/bash_completion ] && ! shopt -oq posix; then
  . /etc/bash_completion
fi

for rcfile in $(ls ~/.bash.d/??-*.sh | sort -n); do
  source "$rcfile"
done

_bashrc_uniq_path() {
  # A case match rather than an associative array, which bash 3.2 lacks.
  local entry new_path= IFS=:
  for entry in $PATH; do
    case ":$new_path:" in
      *":$entry:"*) ;;
      *) new_path="${new_path:+$new_path:}$entry" ;;
    esac
  done
  echo "$new_path"
}
export PATH="$(_bashrc_uniq_path)"

for cmd in nvim vim vi; do
  if command -v $cmd > /dev/null; then
    export EDITOR=$cmd
    break
  fi
done
