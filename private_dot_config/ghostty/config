# A login shell supplies the PATH that GUI launches lack, such as Homebrew's
# on macOS. ~/.tmux.conf picks fish as the default shell.
command = sh -lc 'exec tmux new-session -A -s main'

# Ghostty falls back to its built-in JetBrains Mono and Nerd Font
# symbols on hosts with neither.
font-family = Hack Nerd Font Mono
font-family = Hack
font-size = 12

# Keep in step with the colorscheme in ~/.config/nvim/init.lua.
theme = Jellybeans
# theme = light:GitHub Light Default,dark:GitHub Dark Dimmed
# theme = light:Ayu Light,dark:Ayu Mirage

cursor-style = block
cursor-style-blink = false
confirm-close-surface = false

# Hosts lacking Ghostty's terminfo reject TERM=xterm-ghostty. Inside tmux
# this never arises, since tmux sets its own TERM. Outside tmux, either
# fall back to a TERM every host knows:
# term = xterm-256color
# or install the entry on the host:
#   infocmp -x xterm-ghostty | ssh HOST -- tic -x -
# Hosts with these dotfiles need neither: ~/.bash.d/05-terminfo.sh
# installs ~/.local/share/terminfo/ghostty.info.

# Ghostty marks the tab title and bounces the Dock icon on a bell.
# iTerm2 flashed the screen instead; the nearest match draws a border,
# but only on Linux (GTK). macOS ignores it.
# bell-features = border
